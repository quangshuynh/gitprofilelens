# Copy to .env.local and fill in. Never commit the filled-in file.
#
# Public audit enrichment (README + profile pins) is served by the /api
# serverless functions and needs only GITHUB_TOKEN. The remaining variables
# are for the authenticated private-repository audit.

# Server-only GitHub token used for public README and pinned-repository
# enrichment. A classic token with no scopes, or a fine-grained token with
# public read access, is enough.
GITHUB_TOKEN=

# GitHub App credentials for "Sign in with GitHub" (private audit only).
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Must exactly match a callback URL registered on the GitHub App.
# Locally this is the vercel dev origin.
GITHUB_APP_CALLBACK_URL=http://localhost:3000/api/auth/callback

GITHUB_APP_INSTALL_URL=

# At least 32 random characters. Used to derive the session-encryption key.
SESSION_SECRET=
